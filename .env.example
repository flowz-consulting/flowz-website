# Public measurement ID. Analytics loads only after a visitor accepts cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only. Incoming webhook for the private Discord channel that receives review requests.
# In Discord: channel settings, Integrations, Webhooks, New Webhook, then copy the webhook URL.
# The form reports an error until this is a discord.com webhook URL.
DISCORD_WEBHOOK_URL=
